{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "linfomas",
  "title": "Linfomas",
  "description": "Personas atendidas con este diagnóstico en los establecimientos de salud de Bolivia, por mes y municipio, en las gestiones 2024-2025. Fuente: SNIS, formularios 302b.",
  "keywords": [
    "vigilancia",
    "casos",
    "cáncer"
  ],
  "sources": [
    {
      "title": "SNIS, Ministerio de Salud y Deportes de Bolivia, formulario 302b",
      "path": "https://estadisticas.minsalud.gob.bo/Reportes_Vigilancia/Form_Vigi_2025_302b.aspx"
    }
  ],
  "temporal": {
    "gestiones": [
      2024,
      2025
    ],
    "periodicidad": "mensual"
  },
  "spatial": {
    "unidad": "municipio",
    "municipios": 27
  },
  "resources": [
    {
      "name": "datos",
      "path": "datos.parquet",
      "format": "parquet",
      "mediatype": "application/vnd.apache.parquet",
      "schema": {
        "fields": [
          {
            "name": "gestion",
            "type": "integer",
            "description": "Año calendario (gestión) del registro."
          },
          {
            "name": "mes",
            "type": "integer",
            "description": "Mes, de 1 a 12."
          },
          {
            "name": "fecha_inicio",
            "type": "date",
            "description": "Primer día de la semana o del mes."
          },
          {
            "name": "departamento",
            "type": "string",
            "description": "Nombre del departamento."
          },
          {
            "name": "municipio",
            "type": "string",
            "description": "Nombre del municipio."
          },
          {
            "name": "municipio_codigo",
            "type": "string",
            "description": "Código del municipio, 6 dígitos: departamento (2), provincia (2) y municipio (2)."
          },
          {
            "name": "sexo",
            "type": "string",
            "description": "mujer u hombre."
          },
          {
            "name": "edad_desde",
            "type": "number",
            "description": "Edad mínima de la banda, en años (6 meses = 0,5)."
          },
          {
            "name": "edad_hasta",
            "type": "number",
            "description": "Edad máxima de la banda, en años, sin incluir. Vacía si la banda no tiene límite."
          },
          {
            "name": "edad_grupo",
            "type": "string",
            "description": "Banda de edad en texto corto: \"<6m\" (menos de 6 meses), \"1-4\", \"60+\"."
          },
          {
            "name": "caso",
            "type": "string",
            "description": "nuevo, repetido, seguimiento o primera, como lo registra el formulario.",
            "categories": [
              "nuevo",
              "repetido"
            ]
          },
          {
            "name": "casos",
            "type": "integer",
            "description": "Número de casos en la fila."
          }
        ]
      }
    }
  ],
