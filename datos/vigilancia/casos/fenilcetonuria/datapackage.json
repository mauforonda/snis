{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "fenilcetonuria",
  "title": "Fenilcetonuria",
  "description": "Personas atendidas con este diagnóstico en los establecimientos de salud de Bolivia, por semana y municipio, en las gestiones 2024-2025. Fuente: SNIS, formularios 302a.",
  "keywords": [
    "vigilancia",
    "casos",
    "metabólica congénita"
  ],
  "sources": [
    {
      "title": "SNIS, Ministerio de Salud y Deportes de Bolivia, formulario 302a",
      "path": "https://estadisticas.minsalud.gob.bo/Reportes_Vigilancia/Form_Vigi_2025_302a.aspx"
    }
  ],
  "temporal": {
    "gestiones": [
      2024,
      2025
    ],
    "periodicidad": "semanal"
  },
  "spatial": {
    "unidad": "municipio",
    "municipios": 1
  },
  "resources": [
    {
      "name": "datos",
      "path": "datos.parquet",
      "format": "parquet",
      "mediatype": "application/vnd.apache.parquet",
      "schema": {
        "fields": [
          {
            "name": "gestion",
            "type": "integer",
            "description": "Año calendario (gestión) del registro."
          },
          {
            "name": "semana",
            "type": "integer",
            "description": "Semana epidemiológica, de 1 a 53. Va de domingo a sábado."
          },
          {
            "name": "fecha_inicio",
            "type": "date",
            "description": "Primer día de la semana o del mes."
          },
          {
            "name": "departamento",
            "type": "string",
            "description": "Nombre del departamento."
          },
          {
            "name": "municipio",
            "type": "string",
            "description": "Nombre del municipio."
          },
          {
            "name": "municipio_codigo",
            "type": "string",
            "description": "Código del municipio, 6 dígitos: departamento (2), provincia (2) y municipio (2)."
          },
          {
            "name": "sexo",
            "type": "string",
            "description": "mujer u hombre."
          },
          {
            "name": "edad_desde",
            "type": "number",
            "description": "Edad mínima de la banda, en años (6 meses = 0,5)."
          },
          {
            "name": "edad_hasta",
            "type": "number",
            "description": "Edad máxima de la banda, en años, sin incluir. Vacía si la banda no tiene límite."
          },
          {
            "name": "edad_grupo",
            "type": "string",
            "description": "Banda de edad en texto corto: \"<6m\" (menos de 6 meses), \"1-4\", \"60+\"."
          },
          {
            "name": "casos",
            "type": "integer",
            "description": "Número de casos en la fila."
          }
        ]
      }
    }
  ],
  "snis": {
    "dominio": "vigilancia",
    "clasificacion": "casos",
    "tema": "metabólica congénita",
    "filas": 4,
    "totales": {
      "2024": 4,
      "2025": 1
    },
    "edades": [
      {
        "gestiones": "2024-2025",
        "bandas": "7d-28d"
      }
    ],
    "advertencias": [],
    "correcciones": [],
    "relacionados": [],
    "procedencia": [
      {
        "gestiones": "2024",
        "formulario": "302a",
        "variable": "Fenilcetonuria",
        "soaps": "7.0.1 (2026)",
        "cie10": "E70",
        "cie10_codigos": "E70.0"
      },
      {
        "gestiones": "2025",
        "formulario": "302a",
        "variable": "4. Fenilcetonuria",
        "soaps": "7.0.1 (2026)",
        "cie10": "E70",
        "cie10_codigos": "E70.0"
      }
    ]
  }
}
