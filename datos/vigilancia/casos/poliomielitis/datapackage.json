{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "poliomielitis",
  "title": "Poliomielitis",
  "description": "Personas atendidas con este diagnóstico en los establecimientos de salud de Bolivia, por semana y municipio, en las gestiones 2001-2003. Fuente: SNIS, formularios 302.",
  "keywords": [
    "vigilancia",
    "casos",
    "inmunoprevenible"
  ],
  "sources": [
    {
      "title": "SNIS, Ministerio de Salud y Deportes de Bolivia, formulario 302",
      "path": "https://estadisticas.minsalud.gob.bo/Reportes_Vigilancia/Form_Vigi_2001.aspx"
    }
  ],
  "temporal": {
    "gestiones": [
      2001,
      2002,
      2003
    ],
    "periodicidad": "semanal"
  },
  "spatial": {
    "unidad": "municipio",
    "municipios": 12
  },
  "resources": [
    {
      "name": "datos",
      "path": "datos.parquet",
      "format": "parquet",
      "mediatype": "application/vnd.apache.parquet",
      "schema": {
        "fields": [
          {
            "name": "gestion",
            "type": "integer",
            "description": "Año calendario (gestión) del registro."
          },
          {
            "name": "semana",
            "type": "integer",
            "description": "Semana epidemiológica, de 1 a 53. Va de domingo a sábado."
          },
          {
            "name": "fecha_inicio",
            "type": "date",
            "description": "Primer día de la semana o del mes."
          },
          {
            "name": "departamento",
            "type": "string",
            "description": "Nombre del departamento."
          },
          {
            "name": "municipio",
            "type": "string",
            "description": "Nombre del municipio."
          },
          {
            "name": "municipio_codigo",
            "type": "string",
            "description": "Código del municipio, 6 dígitos: departamento (2), provincia (2) y municipio (2)."
          },
          {
            "name": "edad_desde",
            "type": "number",
            "description": "Edad mínima de la banda, en años (6 meses = 0,5)."
          },
          {
            "name": "edad_hasta",
            "type": "number",
            "description": "Edad máxima de la banda, en años, sin incluir. Vacía si la banda no tiene límite."
          },
          {
            "name": "edad_grupo",
            "type": "string",
            "description": "Banda de edad en texto corto: \"<6m\" (menos de 6 meses), \"1-4\", \"60+\"."
          },
          {
            "name": "casos",
            "type": "integer",
            "description": "Número de casos en la fila."
          }
        ]
      }
    }
  ],
  "snis": {
    "dominio": "vigilancia",
    "clasificacion": "casos",
    "tema": "inmunoprevenible",
    "filas": 18,
    "totales": {
      "2001": 1,
      "2002": 18,
      "2003": 3
    },
    "edades": [
      {
        "gestiones": "2001",
        "bandas": "15-59"
      },
      {
        "gestiones": "2002",
        "bandas": "<1, 1-4, 5-14, 15-59"
      },
      {
        "gestiones": "2003",
        "bandas": "1-4"
      }
    ],
    "advertencias": [],
    "correcciones": [],
    "relacionados": [],
    "procedencia": [
      {
        "gestiones": "2001-2003",
        "formulario": "302",
        "variable": "24.- Poliomielitis",
        "soaps": "",
        "cie10": "",
        "cie10_codigos": ""
      }
    ]
  }
}
