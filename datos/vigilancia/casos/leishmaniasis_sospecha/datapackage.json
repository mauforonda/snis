{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "leishmaniasis_sospecha",
  "title": "Leishmaniasis (sospecha)",
  "description": "Personas atendidas con este diagnóstico en los establecimientos de salud de Bolivia, por semana y municipio, en las gestiones 2010-2014. Fuente: SNIS, formularios 302.",
  "keywords": [
    "vigilancia",
    "casos",
    "vectorial"
  ],
  "sources": [
    {
      "title": "SNIS, Ministerio de Salud y Deportes de Bolivia, formulario 302",
      "path": "https://estadisticas.minsalud.gob.bo/Reportes_Vigilancia/Form_Vigi_2014_2.aspx"
    }
  ],
  "temporal": {
